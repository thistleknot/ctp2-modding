				if (p == 4) { GrantAdvance(player[0], AdvanceDB(ADVANCE_HOME_DEATH)); }
				if (p == 5) { GrantAdvance(player[0], AdvanceDB(ADVANCE_HOME_CHAOS)); }
			}
		}
	}
}
