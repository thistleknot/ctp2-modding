	int_t p;
	p = player[0];
	if (p >= 1) {
		if (p <= 5) {
			if (SmmHomeGrantLatch[p] == 0) {
				SmmHomeGrantLatch[p] = 1;
				if (p == 1) { GrantAdvance(player[0], AdvanceDB(ADVANCE_HOME_LIFE)); }
				if (p == 2) { GrantAdvance(player[0], AdvanceDB(ADVANCE_HOME_NATURE)); }
