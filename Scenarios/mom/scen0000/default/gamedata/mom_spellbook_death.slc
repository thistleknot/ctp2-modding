        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Rare (6 spells) -- requires rung >= 2
    Button(ID_MOM_SPELLHUB_BTN_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 2) {
            Message(player[0], 'MomSpell_death_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Very Rare (6 spells) -- requires rung >= 4
    Button(ID_MOM_SPELLHUB_BTN_VERY_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 4) {
            Message(player[0], 'MomSpell_death_VERY_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
}

