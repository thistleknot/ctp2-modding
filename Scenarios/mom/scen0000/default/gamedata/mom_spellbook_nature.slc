// Research-gated: each rarity requires a sphere ladder advance.

// ===== NATURE SPELLBOOK HUB =====
alertbox 'MomSpellHub_nature' {
    Show();
    Text(ID_MOM_SPELLHUB_NATURE);

    Button(ID_MOM_SPELL_CLOSE) {
        Kill();
    }
    // Common (8 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_COMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_nature_COMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Uncommon (8 spells) -- requires rung >= 1
    Button(ID_MOM_SPELLHUB_BTN_UNCOMMON) {
        Kill();
        if (MomSphereRung[player[0]] >= 1) {
            Message(player[0], 'MomSpell_nature_UNCOMMON_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Rare (8 spells) -- requires rung >= 2
    Button(ID_MOM_SPELLHUB_BTN_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 2) {
            Message(player[0], 'MomSpell_nature_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
    // Very Rare (8 spells) -- requires rung >= 4
    Button(ID_MOM_SPELLHUB_BTN_VERY_RARE) {
        Kill();
        if (MomSphereRung[player[0]] >= 4) {
            Message(player[0], 'MomSpell_nature_VERY_RARE_1');
        } else {
            Message(player[0], 'MomSpellLocked');
        }
    }
}

