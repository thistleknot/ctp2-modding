# Scenario game data lives in its own repos (ctp2-momjr etc.) — never here.
Scenarios/
scen0000/
**/scen0000/

# Python / build artifacts
__pycache__/
*.pyc
*.pyo
.task_graph.db

# Generated workbooks / large binaries (tools regenerate these)
*.xlsx
# ...except the example's workbook, which is tracked ON PURPOSE: it is the
# in-between artifact, so you can see what csv -> xlsx actually produces
# without running the pipeline, and a rerun shows the drift as a diff.
!examples/**/*.xlsx
*.zip
*.rar
*.7z

# uiwalk run output: captures, logs and crash dumps, gigabytes of it.
# The scripts, steps and goldens ARE tracked; what a run produced is not.
tools/uiwalk/runs/
*.log

# OS junk
Thumbs.db
desktop.ini
nul
